# Доступ ноутбука к VPS для заливки роликов (T15).
# Скопировать в video/vps.env и заполнить. В git не коммитится — тут адрес сервера клиента.

# Адрес VPS и пользователь, под которым живёт диспетчер (создаётся в deploy/vps-setup.md).
VPS_HOST=vps.example.com
VPS_USER=pipeline

# Порт SSH, если он нестандартный.
VPS_PORT=22

# Где на сервере лежит диспетчер (там же выполняется npm run ingest:video).
VPS_DISPATCHER_DIR=/opt/content-pipeline/dispatcher

# Временная папка на сервере, куда сначала кладётся ролик. После приёма файл оттуда удаляется:
# наружу его отдаёт публичная статика, а не эта папка.
VPS_TMP=/tmp
