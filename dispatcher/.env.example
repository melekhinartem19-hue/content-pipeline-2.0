# Скопируй в dispatcher/.env и заполни. Файл .env в git НЕ коммитится.

# ── T01: спайн диспетчера ──────────────────────────────────────────────
# Токен ТЕСТОВОГО Telegram-бота (от @BotFather) для локальной отладки.
TELEGRAM_BOT_TOKEN=

# Команда запуска Claude Code. Обычно просто "claude" (если в PATH).
CLAUDE_BIN=claude

# Тайм-аут одного вызова claude -p, миллисекунды.
CLAUDE_TIMEOUT_MS=120000

# Рабочая папка подпроцесса claude -p. Пусто = системный temp (нейтральная папка,
# чтобы агент не подхватывал строительный CLAUDE.md репозитория).
# CLAUDE_CWD=

# ── T02: SQLite ────────────────────────────────────────────────────────
# Путь к файлу БД. Пусто = dispatcher/data/pipeline.sqlite.
# DB_PATH=

# ── T03: 6 ботов + форум-группа (заполняется по мере роллаута) ──────────
# Порядок и рецепт — specs/bots-rollout-plan.md. Раскомментируй по 1–2 за сессию.
#
# Как узнать ID: запусти с DEBUG_IDS=1 и напиши в группу/топик — бот напечатает
# chat.id (это FORUM_GROUP_ID), thread (это TOPIC_*) и текст сообщения. Текст важен:
# в Bot API нет метода «перечислить топики форума», поэтому пиши в каждый топик слово
# с именем агента — по нему и сопоставишь thread с нужным TOPIC_*.
# DEBUG_IDS=1

# FORUM_GROUP_ID=

# Кто имеет право говорить с ботами — user_id через запятую (свой и клиента).
# ПУСТО = фильтр выключен, боты отвечают ЛЮБОМУ, кто написал им в личку. На боевом сервере
# заполнять обязательно: каждое сообщение постороннего уходит в claude -p и тратит Pro-подписку
# клиента. Как узнать id: написать боту в личку — в лог диспетчера напечатается строка [access]
# с user_id (при пустом OWNER_IDS бот ответит как обычно, при заполненном чужом — «Нет доступа»).
# Либо переслать своё сообщение боту @userinfobot. Только числа: «@username» или «;» вместо запятой
# не распознаются — и если не распознано ни одно, фильтр ВЫКЛЮЧЕН (на старте об этом будет ⚠️).
# Фильтр закрывает и текст, и кнопки карточек согласования.
# OWNER_IDS=

# T03-A — Сценарист:
# BOT_TOKEN_WRITER=
# TOPIC_WRITER=

# T03-B — Продюсер + Издатель:
# BOT_TOKEN_PRODUCER=
# TOPIC_PRODUCER=
# BOT_TOKEN_PUBLISHER=
# TOPIC_PUBLISHER=

# T03-C — Разведчик + Дизайнер:
# BOT_TOKEN_SCOUT=
# TOPIC_SCOUT=
# BOT_TOKEN_DESIGNER=
# TOPIC_DESIGNER=

# T03-D — Презентатор:
# BOT_TOKEN_PRESENTER=
# TOPIC_PRESENTER=

# T16 (Фаза 5) — Видео и Аналитик. Появляются последними, конвейер работает и без них.
# ВИДЕО — бот-нотификатор: показывает заявки на монтаж и говорит, что залить. Сам он не думает
# и claude -p не зовёт (монтаж идёт на ноуте клиента, см. video/README.md).
# BOT_TOKEN_VIDEO=
# TOPIC_VIDEO=
# АНАЛИТИК — полноценный агент: цифры ему считает диспетчер, он объясняет их и предлагает шаги.
# BOT_TOKEN_ANALYST=
# TOPIC_ANALYST=

# T18 — «Мозг бренда»: сюда клиент пишет идеи, пересылает посты, кидает фото/видео/файлы.
# Текст дописывается в brand-brain/09-inbox.md, файлы (до 20 МБ) — в brand-brain/materials/.
# Бот НЕ думает и claude -p не зовёт: накопленное прочтут все агенты перед следующей задачей.
# Необязательный — конвейер работает и без него. См. specs/brand-inbox.md.
# BOT_TOKEN_BRAIN=
# TOPIC_BRAIN=

# ── T08: публикация в TG-канал клиента ─────────────────────────────────
# Канал, куда уходит одобренный TG-контент. Можно id вида -100… или @username.
# ВАЖНО: бот ИЗДАТЕЛЯ (BOT_TOKEN_PUBLISHER) должен быть админом этого канала
# с правом публикации — иначе Telegram ответит «bot is not a member».
# Как узнать id: временно поднять ботов с DEBUG_IDS=1 не поможет (канал ≠ группа) —
# проще указать @username канала, а для приватного переслать любой пост канала
# боту @userinfobot и взять оттуда id.
# TG_CHANNEL_ID=

# ── T10: рендер каруселей и обложек ────────────────────────────────────
# Рендер нужен headless-браузер. Обычно НИЧЕГО задавать не надо: модуль render/ сам
# находит Chrome/Chromium (кэш playwright, системный Chrome, на Linux — /usr/bin/chromium).
# Задай путь явно, только если браузер лежит нестандартно или их несколько.
# RENDER_BROWSER=/usr/bin/chromium
#
# Куда складывать готовые PNG. Пусто = dispatcher/data/renders (в git не коммитится).
# RENDERS_DIR=
#
# Цвета, шрифт и подпись на слайдах берутся НЕ отсюда, а из brand-brain/08-visual-style.md —
# это часть «мозга бренда», которую заполняет клиент. Пустой слот = нейтральная тёмная тема.

# ── T13: PDF-лид-магниты инста-воронки ─────────────────────────────────
# Три темы воронки лежат НЕ здесь, а в видимом файле manychat/funnel.json
# (cp manychat/funnel.example.json manychat/funnel.json). Секретов там нет.
#
# Путь к конфигу тем, если он лежит не в manychat/funnel.json.
# FUNNEL_CONFIG=
#
# Куда складывать собранные PDF. Пусто = dispatcher/data/pdf (в git не коммитится).
# PDFS_DIR=
#
# Подпапка внутри публичной статики, куда копируются PDF: PUBLIC_BASE_URL/<subdir>/<ключ>.pdf.
# Менять после запуска воронки нельзя — сломаются уже разосланные ссылки.
# PDF_PUBLIC_SUBDIR=funnel
#
# ВАЖНО: ссылки на PDF берутся из PUBLIC_DIR и PUBLIC_BASE_URL (см. блок T11/T12 выше) — тех же
# самых, что нужны Instagram. Без них PDF соберутся, но отдать их воронке будет нечем: файл-PDF
# в инста-директ отправить технически невозможно, только ссылку.
# Сборка запускается вручную командой «/пдф» в топике Презентатора, расписания у неё нет.

# ── T14: инста-воронка в ManyChat (три ключа → три ссылки) ─────────────
# Как это устроено: диспетчер записывает ссылки на PDF в bot-поля ManyChat (pdf_<ключ>), а флоу
# с тремя кнопками собирает ЧЕЛОВЕК в UI ManyChat один раз — API ManyChat умеет только поля.
# Готовую инструкцию с точными именами полей, кнопок и текстов печатает «/воронка настройка».
#
# Ключ API: ManyChat → Settings → API → API Key. Аккаунт КЛИЕНТА, тариф Pro (на бесплатном API
# закрыт). Пусто = синхронизации нет: ссылки можно вставить во флоу руками.
# MANYCHAT_TOKEN=
#
# Базовый адрес API. Менять почти никогда не нужно — только если ManyChat сменит схему путей.
# MANYCHAT_API_URL=https://api.manychat.com
#
# Префикс имён bot-полей: ключ темы content-plan → поле pdf_content_plan.
# ПОСЛЕ настройки флоу менять нельзя: во флоу останутся ссылки на старые имена, и директ отдаст
# пустоту вместо ссылки.
# MANYCHAT_FIELD_PREFIX=pdf_
#
# Сухой прогон: запросы в ManyChat не уходят, а печатаются планом в топик Презентатора.
# MANYCHAT_DRY_RUN=1
#
# Команды в топике Презентатора: «/воронка» — что воронка отдаёт сейчас, «/воронка настройка» —
# инструкция для UI ManyChat, «/воронка синх» — записать ссылки в поля, «/воронка тест план» —
# репетиция ответа в директ. После «/пдф» синхронизация запускается сама, если задан токен.

# ── T15: приём готового ролика с ноута клиента ─────────────────────────
# Монтаж идёт НЕ здесь, а на ноуте клиента: Bot API качает файлы только до 20 МБ, поэтому
# исходники на VPS не приезжают вовсе. Смонтированный лёгкий ролик кладётся по scp и
# регистрируется командой на самом VPS:
#   npm run ingest:video -- --file /tmp/reels.mp4 --caption-file /tmp/caption.txt
# Ролик копируется в ту же публичную статику (PUBLIC_DIR/PUBLIC_BASE_URL из блока T11/T12) —
# Instagram качает Reels по video_url и файл не принимает. Без этих двух переменных приём
# откажет сразу. Портов наружу диспетчер не открывает: доставка идёт по SSH.
#
# Подпапка внутри публичной статики, куда ложатся ролики.
# VIDEO_PUBLIC_SUBDIR=video
#
# Потолок размера принимаемого ролика, МБ. Защита диска VPS.
# VIDEO_MAX_MB=300

# ── T16: Аналитик, метрики площадок и автомонтаж ───────────────────────
# Отчёт «/отчёт» в топике Аналитика работает БЕЗ настройки: факты берутся из собственной базы
# (что создано, одобрено, отклонено, опубликовано). Ниже — только необязательные добавки.
#
# Еженедельный автоотчёт: время по часам сервера. Пусто = только вручную «/отчёт».
# ANALYTICS_AT=10:00
#
# День недели автоотчёта: 0 — воскресенье, 1 — понедельник (по умолчанию).
# ANALYTICS_WEEKDAY=1
#
# За сколько дней считается автоотчёт.
# ANALYTICS_DAYS=7
#
# Метрики площадок (охваты, просмотры) из Instagram и Threads. ВЫКЛЮЧЕНО по умолчанию: инсайтам
# нужны отдельные права (instagram_manage_insights / threads_manage_insights). App Review мы не
# проходим, но на СВОИХ аккаунтах в dev-mode клиент выдаёт их себе сам. Без этого отчёт просто
# выйдет без цифр площадок — он и так осмысленный.
# ANALYTICS_INSIGHTS=1
#
# Автомонтаж настройки не требует: одобренный сценарий Reels САМ становится заявкой на монтаж,
# ноут забирает её командой npm run video:jobs (video/pull-jobs.sh) и закрывает заливкой ролика.

# ── T09: тренды через Apify (основной путь сбора) ──────────────────────
# Сбор постов из IG/Threads делает Apify: его актор ходит в соцсети сам, диспетчер никуда
# не логинится. Аккаунт Apify — клиента, эти три строки клиент заполняет при установке.
#
# 1) Токен: apify.com → Settings → Integrations → API token.
# APIFY_TOKEN=
#
# 2) Акторы из Apify Store. Необязательно: если пусто, берётся поле actor из trends/sources.json.
#    Эти переменные перебивают файл — так актор меняется без правки JSON.
# APIFY_ACTOR_IG=apify/instagram-scraper
# APIFY_ACTOR_THREADS=
#
# 3) Кого смотреть — НЕ здесь, а в видимом файле trends/sources.json
#    (cp trends/sources.example.json trends/sources.json). Секретов там нет.
#
# Время суточного автосбора, HH:MM по времени сервера. Пусто = только вручную «/тренды»
# в топике Разведчика. Лимит «прогонов в сутки» задаётся в trends/sources.json.
# TRENDS_AT=09:00
#
# Путь к файлу источников, если он лежит не в trends/sources.json.
# TRENDS_SOURCES=
#
# Кем собирать: apify (основной) | login (резерв «вариант C», НЕ реализован — включать нельзя
# без резидентного прокси и постоянной cookie-сессии, см. specs/trends-apify.md).
# TRENDS_PROVIDER=apify
#
# Потолок ожидания одного прогона актора, мс (по нему прогон принудительно останавливается,
# чтобы зависший актор не доедал кредиты).
# APIFY_TIMEOUT_MS=300000

# ── T11/T12: публикация в Threads и Instagram (Graph API, dev-mode) ────
# App Review в Meta мы НЕ проходим. Значит: приложение создаёт клиент, клиент = админ/тестер,
# публикация только в ЕГО собственные аккаунты. Все значения ниже вводит клиент при установке.
#
# ПОРЯДОК НАСТРОЙКИ (в день, когда приехали креды):
#   1) заполнить переменные этого блока;
#   2) npm run check:meta  — предполётная проверка: токены, права, публичная статика.
#      Она НИЧЕГО не публикует, гоняй сколько угодно раз, правя .env между прогонами.
#      То же самое из Telegram: «/проверка» в топике Издателя.
#   3) PUBLISH_DRY_RUN=1 + «Одобрить» — посмотреть план вызовов, ничего не отправляя;
#   4) снять флаг, перезапустить сервис, опубликовать по-настоящему.
# Пока п. 2 не зелёный, публиковать бессмысленно: ошибку всё равно вернёт Meta, но без подсказки.
#
# Версия Graph API (одна на обе площадки).
# META_GRAPH_VERSION=v21.0
#
# Приложение Meta — НЕОБЯЗАТЕЛЬНО и только для «/проверка»: по этой паре Meta отдаёт срок жизни
# токена и список выданных прав. Публикации они не нужны. Где взять: developers.facebook.com →
# приложение клиента → Settings → Basic (App ID и App Secret).
# ЗАЧЕМ ЗАПОЛНЯТЬ: long-lived токен живёт 60 дней, и «всё вдруг перестало публиковаться через два
# месяца» — это почти всегда он. С этой парой проверка назовёт дату истечения заранее.
# META_APP_ID=
# META_APP_SECRET=
#
# Instagram: id бизнес-аккаунта (17841…) и long-lived токен с правами
# instagram_basic + instagram_content_publish + pages_read_engagement.
# IG_USER_ID=
# IG_ACCESS_TOKEN=
#
# Threads: ОТДЕЛЬНЫЙ API (graph.threads.net), отдельное приложение и отдельный токен
# с правами threads_basic + threads_content_publish. Токен от Instagram здесь НЕ подойдёт.
# THREADS_USER_ID=
# THREADS_ACCESS_TOKEN=
#
# Публичная статика — ОБЯЗАТЕЛЬНА для Instagram: он скачивает картинку по ссылке сам и
# локальный файл не примет. PUBLIC_DIR — папка, которую раздаёт Nginx; PUBLIC_BASE_URL — её
# адрес снаружи (обязательно https, иначе Meta не заберёт).
# PUBLIC_DIR=/var/www/content-pipeline
# PUBLIC_BASE_URL=https://media.example.com
#
# Сухой прогон: вызовы в Meta не уходят, а печатаются планом в топик Издателя. Статус элемента
# при этом НЕ меняется — удобно проверить настройку, ничего не опубликовав.
# На «/проверка» и npm run check:meta флаг не влияет: они и так ничего не публикуют.
# PUBLISH_DRY_RUN=1
#
# Reels: Meta принимает ролик и обрабатывает его асинхронно — публиковать можно только после того,
# как она ответит FINISHED. По умолчанию ждём 36 попыток × 5 с = 3 минуты, этого хватает обычному
# ролику на 30–60 секунд. Тяжёлый или длинный ролик может обрабатываться дольше: тогда диспетчер
# честно скажет, сколько ждал, и карточку можно одобрить повторно. Менять только если это повторяется.
# IG_STATUS_ATTEMPTS=36
# IG_POLL_MS=5000

# ── Вариант C: публикация живым браузером (решение владельца 15.09.2026) ──────────────────────
# Альтернатива Graph API: диспетчер заходит в аккаунт клиента как человек и постит через
# веб-интерфейс. Путь через API остаётся рабочим — если браузер упрётся в проверку, вернуться
# к API можно сменой ОДНОЙ переменной ниже, код править не нужно.
#
# ЧЕМ ПЛАТИМ. Автоматизация веб-интерфейса нарушает правила Instagram, и риск здесь несёт
# аккаунт клиента, а не сервер. Вход с датацентрового IP почти наверняка потребует кода
# подтверждения. Решение принято владельцем осознанно — см. правило 4 в CLAUDE.md.
#
# api (по умолчанию) — публикуем через Graph API | browser — через живой браузер
# IG_MODE=api
#
# Логин и пароль аккаунта клиента. Вписывать ТОЛЬКО здесь, на сервере. Никогда — в git,
# в переписку и в тикеты. Threads отдельного пароля не имеет: он входит этим же аккаунтом.
# IG_LOGIN=
# IG_PASSWORD=
#
# Куда положить профиль браузера с сессией. По умолчанию dispatcher/data/browser-profile.
# ПАПКУ НЕЛЬЗЯ ТЕРЯТЬ И НЕЛЬЗЯ ЧИСТИТЬ: внутри куки входа, и её пропажа означает новый вход,
# то есть новый код подтверждения. Бэкапить вместе с brand-brain.
# IG_PROFILE_DIR=
#
# Скриншоты проверок входа (по умолчанию dispatcher/data/browser-shots) — по ним видно,
# куда Instagram отправил код и не заблокирован ли аккаунт.
# IG_SHOTS_DIR=
#
# Показать окно браузера. На VPS окна нет — только для отладки на машине с экраном.
# IG_HEADFUL=1
#
# Первый вход делается руками ОДИН раз, уже после заполнения переменных:
#   cd dispatcher && npm run ig:login
# Повторно входить не нужно и не надо: серия входов уводит аккаунт в проверку.
